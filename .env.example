# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is listed in .gitignore and must never be committed.

# Your own OpenAI API key (https://platform.openai.com/api-keys).
# Only needed for live text mode, voice mode and OpenAI embeddings.
# Tests and the offline demo run without it.
OPENAI_API_KEY=

# Model used by the text-only agent.
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Model used by the Realtime (speech-to-speech) voice agent.
OPENAI_REALTIME_MODEL=gpt-realtime

# Embeddings for the knowledge base: "local" (offline, no key) or "openai".
EMBEDDINGS_PROVIDER=local

# Where the dummy data lives. Leave empty when running from a clone; set an absolute
# path when the package is installed without -e (for example in a container).
VOICE_AGENT_DATA_DIR=

# Where runtime files (vector store, logs, approval records) are written.
VOICE_AGENT_VAR_DIR=var

# Optional: pretend "now" is this local date-time for the demo calendar (for example after the
# demo dates have passed). Leave empty to use the real clock.
VOICE_AGENT_NOW=

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
